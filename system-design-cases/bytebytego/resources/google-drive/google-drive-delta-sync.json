{"schema_version":1,"diagram_type":"architecture","meta":{"title":"Google Drive Block Delta Synchronization","quality_profile":"showcase","viewBox":[1280,680],"views":[{"id":"upload","label":"Delta upload","focus":["device","chunker","block-service","object-storage","metadata"],"note":"The client uploads only changed content-addressed blocks before committing a new version."},{"id":"sync","label":"Device synchronization","focus":["metadata","notifications","other-device","object-storage"],"note":"Metadata updates notify other devices, which download only missing blocks."}]},"components":[{"id":"device","type":"external","label":"Primary Device","sublabel":"edits local file","pos":[35,180],"size":[160,64]},{"id":"other-device","type":"external","label":"Other Device","sublabel":"receives sync event","pos":[35,500],"size":[160,64]},{"id":"chunker","type":"backend","label":"Chunker and Hasher","sublabel":"4 MB blocks and SHA-256","pos":[260,180],"size":[190,64]},{"id":"block-service","type":"backend","label":"Block Server","sublabel":"deduplication and missing-block check","pos":[510,180],"size":[205,64]},{"id":"object-storage","type":"database","label":"Encrypted Block Storage","sublabel":"content-addressed cloud objects","pos":[780,180],"size":[205,64]},{"id":"metadata","type":"backend","label":"Metadata Service","sublabel":"file tree, versions, block list","pos":[780,390],"size":[205,64]},{"id":"notifications","type":"messagebus","label":"Sync Notifications","sublabel":"WebSocket or long polling","pos":[510,500],"size":[205,64]}],"connections":[{"id":"edit","from":"device","to":"chunker","label":"edit and split file","variant":"emphasis"},{"id":"missing-check","from":"chunker","to":"block-service","label":"check block hashes","variant":"emphasis"},{"id":"upload-blocks","from":"block-service","to":"object-storage","label":"upload missing blocks","variant":"emphasis"},{"id":"commit","from":"block-service","to":"metadata","label":"commit new version","variant":"emphasi
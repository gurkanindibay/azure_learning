cate to N owners","fromSide":"top","toSide":"left","labelDy":-24},{"from":"request-receiving-replica","to":"replica-two","label":"replicate to N owners","variant":"emphasis","labelDy":-28},{"from":"request-receiving-replica","to":"replica-three","label":"replicate to N owners","fromSide":"bottom","toSide":"left","labelDy":24},{"from":"replica-two","to":"quorum-ack","label":"W or R response","labelDy":-28},{"from":"replica-one","to":"gossip-membership","label":"exchange heartbeat","labelDy":-28},{"from":"replica-one","to":"merkle-repair","label":"compare replica ranges","fromSide":"top","toSide":"bottom","via":[[655,70],[1120,70],[1120,580],[955,580]],"labelAt":[1040,580]}],"cards":[{"dot":"cyan","title":"Tunable Quorum","items":["The selected N owners acknowledge a write after W replies or answer a read after R replies.","W + R > N gives an overlapping latest-version replica."]},{"dot":"emerald","title":"Conflict Metadata","items":["Vector clocks expose concurrent writes instead of silently overwriting siblings.","The client merges sibling values when neither version dominates."]},{"dot":"amber","title":"Failure Recovery","items":["Gossip marks unreachable members without a central leader.","Merkle trees localize anti-entropy transfers to mismatched key ranges."]}]}

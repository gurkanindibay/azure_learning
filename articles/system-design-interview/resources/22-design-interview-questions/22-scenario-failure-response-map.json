  "cards": [
    {"dot": "cyan", "title": "Find the failure", "items": ["Read-heavy spikes, races, stale state, and duplicate delivery need different remedies", "Name the bottleneck before naming the product"]},
    {"dot": "amber", "title": "Protect correctness", "items": ["Use idempotency, ordering, locks, or circuit breakers where state can be corrupted", "Use queues and backpressure to contain bursts"]},

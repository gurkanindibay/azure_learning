        "id": "deliver",
        "label": "Deliver safely",
        "focus": [
          "queue",
          "worker",
          "dedupe",
          "provider",
          "status"
        ],
        "note": "A unique notification ID prevents duplicate effects after acknowledgement loss."
      },
      {
        "id": "recover",
        "label": "Recover failures",
        "focus": [
          "worker",
          "queue",
          "provider",
          "dlq",
          "status"
        ],
        "note": "Transient failures retry with backoff while permanent failures move to the DLQ."
      }
    ]

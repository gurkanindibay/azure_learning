    {"id": "events", "type": "messagebus", "label": "Kafka score events", "pos": [350, 510]},
    {"id": "projector", "type": "backend", "label": "Ranking projector", "pos": [700, 330]},
    {"id": "redis", "type": "database", "label": "Redis Sorted Sets", "pos": [980, 180]},
    {"id": "dimensions", "type": "database", "label": "Ranking dimensions", "pos": [980, 510]},
    {"id": "gateway", "type": "backend", "label": "Realtime gateway", "pos": [1240, 330]},
    {"id": "players", "type": "external", "label": "Players", "pos": [1400, 330]}
  ],
  "connections": [
    {"id": "write-score", "from": "game", "to": "scores", "label": "persist official score", "variant": "emphasis", "labelDy": -18},
    {"id": "publish-score", "from": "game", "to": "events", "label": "publish ordered event", "variant": "emphasis", "labelDy": 18},
    {"id": "consume", "from": "events", "to": "projector", "label": "consume and deduplicate", "variant": "emphasis"},
    {"id": "rebuild", "from": "scores", "to": "projector", "label": "rebuild after cache loss", "variant": "dashed"},
    {"id": "rank", "from": "projector", "to": "redis", "label": "ZADD by latest version", "variant": "emphasis", "labelDy": -18},

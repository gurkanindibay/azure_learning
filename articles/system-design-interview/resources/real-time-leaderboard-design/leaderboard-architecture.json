    {"id": "query", "from": "redis", "to": "gateway", "label": "top 100 and player rank", "variant": "default"},
    {"id": "push", "from": "dimensions", "to": "gateway", "label": "publish ranking delta", "variant": "dashed"},
    {"id": "update", "from": "gateway", "to": "players", "label": "WebSocket update", "variant": "emphasis", "labelDy": -24}
  ],
  "cards": [
    {"dot": "cyan", "title": "Fast reads", "items": ["Sorted Sets keep rank and score queries near constant time", "WebSockets push only relevant ranking changes"]},
    {"dot": "amber", "title": "Correctness", "items": ["The database remains the source of truth", "Versioned events prevent late updates from lowering a score"]},
    {"dot": "rose", "title": "Scale and recovery", "items": ["Separate dimensions can be partitioned independently", "The projector rebuilds Redis after cache loss"]}

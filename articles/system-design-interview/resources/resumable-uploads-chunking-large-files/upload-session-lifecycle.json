{
  "schema_version": 1,
  "diagram_type": "lifecycle",
  "meta": {"title": "Resumable Upload Session Lifecycle", "quality_profile": "showcase", "viewBox": [1100, 566]},
  "lanes": [
    {"id": "main", "label": "Upload session"},
    {"id": "recovery", "label": "Recovery path"}
  ],
  "states": [
    {"id": "created", "type": "start", "label": "Session created", "lane": "main", "col": 0, "step": "01"},
    {"id": "uploading", "type": "active", "label": "Uploading chunks", "lane": "main", "col": 1, "step": "02"},
    {"id": "tracked", "type": "active", "label": "Chunks tracked", "lane": "main", "col": 2, "step": "03"},
    {"id": "assembled", "type": "success", "label": "Object assembled", "lane": "main", "col": 2, "yOffset": 110, "step": "04"},
    {"id": "interrupted", "type": "waiting", "label": "Network interrupted", "lane": "recovery", "col": 0, "yOffset": 100},
    {"id": "retrying", "type": "active", "label": "Retry missing chunks", "lane": "recovery", "col": 2}
  ],
  "transitions": [
    {"id": "start-upload", "from": "created", "to": "uploading", "route": "straight"},
    {"id": "send-chunk", "from": "uploading", "to": "tracked", "route": "straight"},
    {"id": "complete", "from": "tracked", "to": "assembled", "route": "straight", "variant": "emphasis"},
    {"id": "disconnect", "from": "uploading", "to": "interrupted", "route": "drop", "variant": "dashed"},
    {"id": "resume", "from": "interrupted", "to": "retrying", "route": "drop"},
    {"id": "retry-complete", "from": "retrying", "to": "tracked", "route": "drop"}
  ],
  "cards": [
    {"dot": "cyan", "title": "Resume behavior", "items": ["Persist the session ID across reconnects", "Query missing chunk numbers before retrying"]},
    {"dot": "amber", "title": "Duplicate behavior", "items": ["Composite session and chunk key prevents duplicate storage", "Checksum failure returns the bad chunk to retry"]}
  ]
}
